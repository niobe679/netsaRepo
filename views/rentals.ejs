<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
 
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    body {
      margin: 0;
      height: auto;
      background-image: url('/images/just\ for\ export.svg');
      background-size: cover;
    }
  </style>
</head>
<body>
  <!-- Header -->
  <%- include('partials/header') %>

  <!-- Hero Section -->


  <!-- Property Listings -->
  <section class="py-5">
    <div class="container">
      <h2 class="mb-4" style="color: white;">Available Properties</h2>
      <div class="row">
        <% properties.forEach(property => { %>
          <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
              <img src="<%= property.imageUrl %>" class="card-img-top" alt="<%= property.name %>">
              <div class="card-body">
                <h5 class="card-title"><%= property.name %></h5>
                <p class="fw-bold text-primary" style="font-size: x-large;">Price: $<%= property.price %></p>
                        <p>Location: <%= property.location %></p>
                        <p>Bedrooms: <%= property.bedrooms %></p>
                        <p>Square Feet: <%= property.squarefeet %> sqft</p>
                        <p>Type: <%= property.type %></p>
              </div>
            </div>
          </div>
        <% }) %> 
      </div>
      
    </div>
  </section>

  <!-- Footer -->
  <%- include('partials/footer') %>

  <!-- Bootstrap JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>