                <p class="fw-bold text-primary">Price: <%= property.price %></p>
              </div>
            </div>
          </div>
        <% }) %> 
      </div>
    </div>
  </section>
  <!-- Property Listings -->
  <section class="py-5">
    <div class="container">
      <h2 class="mb-4">Available Properties</h2>
      <div class="row">
        <% properties.forEach(property => { %>
          <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
              <img src="<%= property.image %>" class="card-img-top" alt="<%= property.name %>">
              <div class="card-body">
                <h5 class="card-title"><%= property.name %></h5>
                <p class="card-text">Location: <%= property.location %></p>
                <p class="fw-bold text-primary">Price: <%= property.price %></p>
              </div>
            </div>
          </div>
        <% }) %> 
