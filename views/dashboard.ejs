  <%- include('partials/footer') %>

  <!-- Bootstrap JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Fetch search results and populate the page
    document.getElementById('searchform').addEventListener('submit', async function (event) {
      event.preventDefault(); // Prevent form submission
      console.log(">> "+document.getElementById('rob').value);
      // const container = document.getElementById('ontainer');
      //const query = document.getElementById('search-query').value;
      //const filter = document.getElementById('search-filter').value;
      const price = document.getElementById('price').value;
      const rob = document.getElementById('rob').value;
      const location = document.getElementById('location').value;
      const bedrooms = document.getElementById('bedrooms').value;
      const squarefeet = document.getElementById('squarefeet').value;
      const type = document.getElementById('propertyType').value;
      
      const propertData = {
        price: price,
        rob: rob,
        location: location,
        bedrooms: bedrooms,
        squarefeet: squarefeet,
        type: type,
        isFilter: new Boolean(true)
      }
      console.log(propertData.isFilter);
        try {
          const queryString = new URLSearchParams(propertData).toString();
          window.location.href = `/api/properties/search?${queryString}`;
    
          }
        catch (error) {
          console.error('Error fetching search results:', error);
          }
    });
  
    document.getElementById('filterform').addEventListener('submit', async function (event) {
      event.preventDefault(); // Prevent form submission
      console.log(">> "+document.getElementById('searchAll').value);
      // const container = document.getElementById('ontainer');
      //const query = document.getElementById('search-query').value;
      //const filter = document.getElementById('search-filter').value;
      const searchAll = document.getElementById('searchAll').value;
      
      const propertData = {
        searchAll: searchAll,
        isFilter: new Boolean(false)
      }
      
      try {
        const queryString = new URLSearchParams(propertData).toString();
        window.location.href = `/api/properties/search?${queryString}`;
  
        }
      catch (error) {
        console.error('Error fetching search results:', error);
        }
    });
  
  </script>
</body>
</html>