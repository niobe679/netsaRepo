<form method="post" id="searchform" >
  
  <!-- Search Bar -->
  <div class="srchfltr">
  
      <input id="price" name="price" type="text" placeholder="Price">
      <select id="rob" name="rob">
        <option value="">Rent or Buy</option>
        <option value="rent">Rent</option>
        <option value="buy">Buy</option>
      </select>
      <input id="location" name="location" type="text" placeholder="Location">
      <input id="bedrooms" name="bedrooms" type="number" placeholder="Bedrooms">
      <input id="squarefeet" name="squarefeet" type="number" placeholder="Square Feet">
      <select id="propertyType" name="propertyType">
        <option value="">Property Type</option>
        <option value="apartment">Apartment</option>
        <option value="house">House</option>
        <option value="commercial">Commercial</option>
        <option value="land">Land</option>
      </select>
      <button type="submit" class="filter-button" >
        <img src="/images/fltr2.png" alt="filter"  />
        Filter</button>
  
    </div>
    
  </form>