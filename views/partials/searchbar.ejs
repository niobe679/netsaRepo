<form id="filterform" method="post" class="search-bar-container">
  <input
    type="text"
    id="searchAll"
    name="searchAll"
    placeholder="Location, Name or Price"
    class="search-input"/>
  <button class="search-button" type="submit">
    <img src="/images/search-icon.jpg" alt="Search"  />
  </button>
</form>

