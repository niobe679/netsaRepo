<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
 
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    body {
      margin: 0;
      height: auto;
      background-image: url('/images/just\ for\ export.svg');
      background-size: fill;
    }
    .modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: visibility 0.3s, opacity 0.3s;
  overflow-y: scroll;
}

.modal-content {
  background-color: #fff;
  padding: 20px;
  border-radius: 8px;
  width: 80%;
  max-width: 1010px;
  height: 100%;
  text-align: center;
  overflow-y: scroll;
}

.modal img {
  max-width: 100%;
  height: auto;
  margin-top: 20px;
}

.hidden {
  visibility: hidden;
  opacity: 0;
}

.modal.active {
  visibility: visible;
  opacity: 1;
}
/* Popup Card Styles */
.popup-card {
    display: none; /* Initially hidden */
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    max-width: 600px;
    background-color: white;
    border: 1px solid #ccc;
    padding: 20px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    z-index: 1000;
    text-align: center;
}

.image-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 10px;
}

.image-container img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
}

/* Close Button */
/* .close-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    font-size: 18px;
    cursor: pointer;
} */

/* Trigger Button */
#showPopupBtn {
    margin: 20px;
}
/* Image Grid Styling */
.image-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 10px;
  margin: 10px 0;
}

.image-grid img {
  width: auto;
  height: auto;
  border-radius: 8px;
  cursor: pointer;
}

#see-all-btn {
  background-color: #007bff;
  color: white;
  padding: 10px 20px;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

#see-all-btn:hover {
  background-color: #0056b3;
}
.nav-item a {
  text-decoration: none;
 
  padding: 10px 20px;
  border-radius: 5px;
}

.nav-item a.active {
  background: linear-gradient(to top, #268a8a,  #1a6d6d);
  color: white;
}
/* Popup Styling */
.popup {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: visibility 0.3s, opacity 0.3s;
  overflow-y: scroll;
}

.popup.active {
  visibility: visible;
  opacity: 1;
}

.popup-content {
  background-color: #025e5d;
  border-radius: 8px;
  padding: 20px;
  width: 90%;
  max-width: 1010px;
  text-align: center;
  position: relative;
}

.close-btn {
  position: absolute;
  top: 10px;
  right: 10px;
  font-size: 34px;
  cursor: pointer;
  color: white;
}

.image-viewer {
  position: relative;
}

.image-viewer img {
  width: 100%;
  max-height: 700px;
  object-fit: contain;
  border-radius: 8px;
}

.arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background-color: rgba(0, 0, 0, 0.5);
  color: white;
  border: none;
  font-size: 24px;
  cursor: pointer;
  padding: 10px;
  border-radius: 50%;
  z-index: 10;
}

.arrow.prev {
  left: 10px;
}

.arrow.next {
  right: 10px;
}

.thumbnail-gallery {
  display: flex;
  gap: 10px;
  overflow-x: auto;
  margin-top: 20px;
}

.thumbnail-gallery img {
  width: 60px;
  height: 60px;
  object-fit: cover;
  border: 2px solid transparent;
  border-radius: 8px;
  cursor: pointer;
}

.thumbnail-gallery img.selected {
  border-color: #007bff;
}

.popup-content h2 {
  margin-bottom: 10px;
  font-size: 24px;
  color: #ffffff;
}

.popup-content p {
  margin: 5px 0;
  font-size: 16px;
  color: #ffffff;
}

  </style>
</head>
<body>
  <!-- Header -->
  <%- include('partials/header') %>

  <!-- Hero Section -->


  <!-- Property Listings -->
  <section class="py-5">
    <div class="container">
      <h2 class="mb-4" style="color: white;">Available Properties</h2>
      <div class="row">
        <% properties.forEach(property => { %>
          <div class="col-md-4 mb-4">
            <div class="card shadow-sm" data-id="<%= property._id %>">
              <img src="<%= property.imageUrl[0].url %>" class="card-img-top" alt="<%= property.name %>">
              <div class="card-body">
                <h5 class="card-title"><%= property.name %></h5>
                <p class="fw-bold text-primary"  style="font-size: x-large;">Price: $<%= property.price %></p>
                        <p>Location: <%= property.location %></p>
                        <p>Bedrooms: <%= property.bedrooms %></p>
                        <p>Square Feet: <%= property.squarefeet %> sqft</p>
                        <p>Type: <%= property.type %></p>
                        <button class="view-details">View Details</button>
              </div>
            </div>
          </div>
        <% }) %> 
      </div>
      
    </div>
  </section>
  

  <div id="popup-card" class="popup hidden">
    <div class="popup-content">
      <span id="close-modal" class="close-btn">&times;</span>
      <!-- <button id="close-modal" class="close-btn" >&times;</button> -->
      <!-- Image Viewer -->
      <h2 id="modal-title">Property Title</h2>
      <p id="modal-price">Price: $0</p>
      <p id="modal-location">Location: Unknown</p>
      <p id="modal-bedrooms">Bedrooms: 0</p>
      <p id="modal-squarefeet">Square Feet: 0</p>

      <div class="image-viewer">
        <button class="arrow prev" id="prev-arrow">&#10094;</button>
        <img id="popup-image" src="" alt="Selected Image" />
        <button class="arrow next" id="next-arrow">&#10095;</button>
      </div>
  
      <!-- Thumbnail Gallery -->
      <div id="thumbnail-gallery" class="thumbnail-gallery">
        <!-- Thumbnails will be dynamically added here -->
          <!-- Property Details -->

      </div>
    </div>
  </div>
  
  <!-- Footer -->
  <%- include('partials/footer') %>

