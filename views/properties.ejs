document.addEventListener('DOMContentLoaded', () => {
  const popup = document.getElementById('popup-card');
  const popupImage = document.getElementById('popup-image');
  const thumbnailGallery = document.getElementById('thumbnail-gallery');
  const closeBtn = document.querySelector('.close-btn');
  const prevArrow = document.getElementById('prev-arrow');
  const nextArrow = document.getElementById('next-arrow');

  // Property details elements
  const modalTitle = document.getElementById('modal-title');
  const modalPrice = document.getElementById('modal-price');
  const modalLocation = document.getElementById('modal-location');
  const modalBedrooms = document.getElementById('modal-bedrooms');
  const modalSquareFeet = document.getElementById('modal-squarefeet');

  let images = [];
  let currentIndex = 0;

  // Open the popup card with property details and images
  function openPopupCard(property) {
    images = property.imageUrl; // Set the images array
    currentIndex = 0; // Start with the first image

    // Populate property details
    modalTitle.textContent = property.name;
    modalPrice.textContent = `Price: $${property.price}`;
    modalLocation.textContent = `Location: ${property.location}`;
    modalBedrooms.textContent = `Bedrooms: ${property.bedrooms}`;
    modalSquareFeet.textContent = `Square Feet: ${property.squarefeet}`;
    console.log("mm ", property);
    // Display thumbnails
    thumbnailGallery.innerHTML = ''; // Clear existing thumbnails
    images.forEach((image, index) => {
      console.log("ll ", image);
      const thumbnail = document.createElement('img');
      thumbnail.src = image.url;
      thumbnail.alt = `Thumbnail ${index + 1}`;
      thumbnail.classList.add('thumbnail');
      if (index === 0) thumbnail.classList.add('selected');

      // Add click event to change main image
      thumbnail.addEventListener('click', () => {
        updateMainImage(index);
      });

      thumbnailGallery.appendChild(thumbnail);
    });

    // Display the first image
    updateMainImage(0);

    // Show the popup
    popup.classList.add('active');
  }

  // Update the main image
  function updateMainImage(index) {
    currentIndex = index;
    popupImage.src = images[index].url;

    // Highlight the selected thumbnail
    document.querySelectorAll('.thumbnail').forEach((thumb, i) => {
      thumb.classList.toggle('selected', i === index);
    });
  }

  // Navigate to the previous image
  prevArrow.addEventListener('click', () => {
    if (currentIndex > 0) {
      updateMainImage(currentIndex - 1);
    }
  });

  // Navigate to the next image
  nextArrow.addEventListener('click', () => {
    if (currentIndex < images.length - 1) {
      updateMainImage(currentIndex + 1);
    }
  });

  // Close the popup
  closeBtn.addEventListener('click', () => {
    popup.classList.remove('active');
  });

  // Example usage: Open popup when clicking on a card
  document.querySelectorAll('.card').forEach((card) => {
    card.addEventListener('click', async () => {
      const propertyId = card.getAttribute('data-id');
      const response = await fetch(`/api/properties/data/${propertyId}`);
      const property = await response.json();
      //const _property = 
      console.log(property);

      openPopupCard(property); // Pass the property object to populate the modal
    });
  });
});
document.getElementById('close-modal').addEventListener('click', (event) => {
  console.log('Close button clicked'); // Debugging log
    document.getElementById('popup-card').classList.remove('active');
  
});
</script>
